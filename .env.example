# Shapley environment template
# Copy to .env and fill in your values. NEVER commit .env.
#
#   cp .env.example .env
#
# .env is gitignored. This file (.env.example) is safe to commit.

# GitHub OAuth App (for "Connect GitHub" repo picker)
# Create at https://github.com/settings/developers
# Set Authorization callback URL to: http://localhost:3000/oauth/callback
# (production: https://your-frontend-url/oauth/callback)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Frontend URL (used for OAuth redirect)
FRONTEND_URL=http://localhost:3000

# GitHub API token (for fetching commit diffs)
# Get one at https://github.com/settings/tokens (needs 'repo' scope for private repos)
# In local dev, the credential surrogate is used if this is empty.
GITHUB_TOKEN=

# Gemini API key (for semantic code scoring)
# Get one at https://aistudio.google.com/apikey
# In local dev, the credential surrogate is used if this is empty.
GEMINI_API_KEY=

# PayPal REST API credentials (from developer.paypal.com > Apps & Credentials)
# Use SANDBOX credentials for testing, never production keys here.
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_MODE=sandbox

# Set to "true" to use frozen demo data (no API calls)
DEMO_MODE=false

# Deployment environment: "production" turns on fail-closed behavior
# (e.g. payouts are refused unless PAYOUT_CONFIRM_TOKEN is set)
ENVIRONMENT=

# CORS: comma-separated allowed frontend origins.
# Defaults to http://localhost:3000 and http://127.0.0.1:3000 when unset.
ALLOWED_ORIGINS=

# Payout confirmation token: when set, POST /api/payout and the agent
# payout tool require the header  X-Shapley-Confirm: <this value>.
# The frontend sends it when NEXT_PUBLIC_PAYOUT_CONFIRM_TOKEN is set to
# the same value at build time. Leave empty for local/demo use, where
# the confirmation modal is the human-confirmation step.
PAYOUT_CONFIRM_TOKEN=
